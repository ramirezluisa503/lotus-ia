# Copia este archivo como .env y ajusta los valores. Nunca subas el .env real al repo.

# Postgres local (Docker Compose)
DATABASE_URL=postgresql+psycopg://lotusia:lotusia_dev@localhost:5432/lotusia

# Postgres en Supabase (solo si se usa para esa base en particular)
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

JWT_SECRET=cambia-esto-por-un-valor-aleatorio-largo
FERNET_KEY=cambia-esto-por-una-llave-fernet-generada
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Envío de correos (recuperación de contraseña). Con Gmail: activa la
# verificación en 2 pasos y genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords -- no uses tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
EMAIL_FROM=tu-correo@gmail.com
