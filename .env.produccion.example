# Variables para docker-compose.prod.yml. En el servidor: cp .env.produccion.example .env
# y llena cada valor. Nunca subas el .env real al repo.

# Dirección pública de la app. Sin dominio propio usa la IP elástica de EC2
# con sslip.io, p. ej. 54.123.45.67 -> 54-123-45-67.sslip.io
DOMINIO=

# Genera cada uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
JWT_SECRET=

# Genera con:  python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Correos de recuperación de contraseña (contraseña de aplicación de Gmail,
# ver backend/.env.example). Opcional: sin esto todo funciona menos ese correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
